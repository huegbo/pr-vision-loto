  journalTagsDraft:[], journalFilterTag:null,
  navMode:'years', selGames:['benz','diamant'], mgYear:'',
  // nav
  selYears:YEARS.slice(0,4), showAllYears:false,
  searchInput:'', search:[], pin:null, sync:false, freezeCol:false, excelMode:false, excelTextSize:(localStorage.getItem('excelTextSize')||'normal'),
  // Côte à côte (colonnes juxtaposées, défilement horizontal) OU empilé verticalement (1 année par bloc pleine largeur)
  sideBySide:(localStorage.getItem('sideBySide')!=='0'),
  // Plage Début → Fin : soit par année (2023→2026), soit par N° de tirage (131→159)
  rangeOn:false, rangeMode:'year', rangeFrom:'', rangeTo:'', rangePanel:false, gamePicker:false,
  shiftAfter:null,   // insertion en cours : N° après lequel insérer (renumérotation auto)
