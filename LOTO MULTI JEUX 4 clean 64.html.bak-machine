  qpGrids:[], qpN:6, qpRepeat:false, qpLines:1, qpNoRepeatAcross:false, qpBalls:false,
  sugN:6, sugMode:'equilibre', sugResult:null, sugWin:100, sugMulti:false, sugGames:[], sugMultiRes:null,
  popup:null,
  colored:{}, coloredCells:{}, colorIdx:0, lastTap:{}, hoverTimer:null, rowMultiNums:new Set(), markRows:{}, markInput:'',
  colorUndoStack:[],
  // Coloriage par lot (dernier(s) tirage(s) / tirage précis / intervalle) + choix de la position (tous / N1..N5 / M1..M5)
  batchColorMode:'last', batchColorN:3, batchColorTirage:'', batchColorStep:2, batchColorRange:20, batchColorPos:'all',
  batchColorScope:'global', // 'global' = colore la valeur partout (peu importe la position) ; 'position' = colore uniquement quand la même position a la même valeur
  batchColorFixed:lsGetOr('lmj_batchDefaultColor',''), // '' = couleur automatique (palette qui tourne) ; sinon un hex fixe utilisé pour tout le lot
  hlColor:null, hlStyle:'fill', menuCtx:null,
