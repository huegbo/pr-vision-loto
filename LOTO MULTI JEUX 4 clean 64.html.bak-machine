      <div onclick="setPronosticOutlineColor('auto')" title="Même couleur que l'affiche" style="height:34px;padding:0 10px;border-radius:17px;cursor:pointer;background:#EEF1F6;border:${state.pronosticOutlineColor==='auto'?'3px solid #16436B':'2px solid #ddd'};display:flex;align-items:center;font-size:9px;font-weight:700;color:#555">AUTO</div>
      ${PRONO_BALL_COLORS.filter(c=>c.css&&!c.css.startsWith('conic')).map(c=>`<div onclick="setPronosticOutlineColor('${c.key}')" style="width:34px;height:34px;border-radius:50%;cursor:pointer;background:${c.css};border:${state.pronosticOutlineColor===c.key?'3px solid #16436B':'2px solid #ddd'}"></div>`).join('')}
    </div>`:''}
    <div style="font-size:10px;font-weight:600;margin-bottom:6px">Police du titre</div>
