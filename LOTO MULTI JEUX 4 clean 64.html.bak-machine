  const items=[
    ['plans','📐','Projets / Plans','#3B82F6','#fff'],
    ['color','🎨','Coloriage manuel','#fff','#E53935'],
    ['color1','🎨1️⃣','Colorier le dernier tirage','#EF5350','#fff'],
    ['color3','🎨3️⃣','Colorier les 3 derniers tirages','#E53935','#fff'],
