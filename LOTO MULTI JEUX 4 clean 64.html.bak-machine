  beninFiltreOpen:false, beninJours:[...BENIN_JOUR_ORDER], beninJeux:[...BENIN_JEU_ORDER],
  beninHeures:[...BENIN_HEURE_ORDER], beninFamilles:[...BENIN_FAMILLE_ORDER],
  ghanaFiltreOpen:false, ghanaJours:[...GHANA_JOUR_ORDER], ghanaJeux:[...GHANA_JEU_ORDER],
  togoFiltreOpen:false, togoJours:[...TOGO_JOUR_ORDER], togoJeux:[...TOGO_JEU_ORDER],
  pronosticOpen:false, pronosticSubTab:'pronostic', pronosticGroupe:'togo', pronosticJeu:TOGO_GAMES[0].key,
  pronosticFormat:'numeros', pronosticCount:2, pronosticNums:[], pronosticTitre:'',
  pronosticBallSize:'moyennes', pronosticTextSize:'normal', pronosticBallColor:'def', pronosticTitleFont:'def', pronosticBoulesFilter:'tous',
  pronosticOutline:false, pronosticOutlineColor:'auto',
