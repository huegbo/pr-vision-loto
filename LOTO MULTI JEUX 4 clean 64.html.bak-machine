    ['past','📕','Consulter journaux (Pass)','#2563EB','#fff'],
    ['journal','📔','Carnet de suivi (jour par jour)','#7C3AED','#fff'],
    ['settings','⚙️','Réglages','#64748B','#fff'],
  ];
  h+=`<div onclick="toggleFab()" style="position:fixed;right:16px;bottom:calc(16px + env(safe-area-inset-bottom));width:52px;height:52px;border-radius:16px;background:linear-gradient(135deg,#6D28D9,#0891B2);box-shadow:0 6px 20px rgba(0,0,0,.35);display:flex;align-items:center;justify-content:center;cursor:pointer;z-index:996;font-size:22px">${state.showFab?'✕':'⊞'}</div>`;
  if(state.showFab){
    h+=`<div onclick="toggleFab()" style="position:fixed;inset:0;background:rgba(0,0,0,.35);z-index:995"></div>
    <div style="position:fixed;right:16px;bottom:142px;z-index:997;background:#1F2D3D;border-radius:18px;padding:16px;width:270px;max-width:80vw;box-shadow:0 12px 40px rgba(0,0,0,.5)">
      <div style="color:#fff;font-size:16px;font-weight:500;text-align:center;margin-bottom:12px">Que voulez-vous faire ?</div>
      ${items.map(([a,ic,lbl,bg,fg])=>`<div onclick="fabGo('${a}')" style="display:flex;align-items:center;gap:10px;background:${bg};color:${fg};border-radius:12px;padding:11px 14px;margin-bottom:10px;cursor:pointer;font-weight:500;font-size:14px"><span style="font-size:18px">${ic}</span>${lbl}</div>`).join('')}
    </div>`;
  }
  return h;
}
function closeSettings(){state.showSettings=false;render();}
// ══════ Sauvegarde/Restauration complète (couleurs, plans, journal, historique, thème) ══════
function exportAllData(){
  const data={};
  for(let i=0;i<localStorage.length;i++){
    const k=localStorage.key(i);
    if(k&&(k.startsWith('lmj_')||k.startsWith('loto_')))data[k]=localStorage.getItem(k);
  }
  if(!Object.keys(data).length){alert('Aucune donnée locale à exporter pour le moment.');return;}
  const blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'});
  const a=document.createElement('a');
  a.href=URL.createObjectURL(blob);
  a.download='forecast_loto90_sauvegarde_'+new Date().toISOString().slice(0,10)+'.json';
  document.body.appendChild(a);a.click();
  setTimeout(()=>{URL.revokeObjectURL(a.href);a.remove();},500);
}
function triggerImportAllData(){
  const inp=document.getElementById('import-all-input');
  if(inp)inp.click();
}
function handleImportAllData(input){
  const file=(input.files||[])[0];
  if(!file)return;
  const reader=new FileReader();
  reader.onload=e=>{
    try{
      const data=JSON.parse(e.target.result);
      const keys=Object.keys(data);
      if(!keys.length)throw new Error('vide');
      const replace=!confirm("Importer "+keys.length+" réglage(s) sauvegardé(s).\n\nOK = Fusionner avec les données actuelles\nAnnuler = Tout remplacer (efface d'abord les données actuelles)");
      if(replace){
        for(let i=localStorage.length-1;i>=0;i--){
          const k=localStorage.key(i);
          if(k&&(k.startsWith('lmj_')||k.startsWith('loto_')))localStorage.removeItem(k);
        }
      }
      keys.forEach(k=>{try{localStorage.setItem(k,data[k]);}catch(_){}});
      alert('Import terminé : '+keys.length+' réglage(s) restauré(s). L\'app va se recharger.');
      location.reload();
    }catch(err){
      alert("Fichier invalide, impossible d'importer.");
    }
  };
  reader.readAsText(file);
  input.value='';
}
