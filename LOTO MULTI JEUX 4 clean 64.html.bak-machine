const CODE=['00','9','8','7','6','5','4','3','2','01','00','09','08','07','06','05','04','03','02','91','90','99','98','97','96','95','94','93','92','81','80','89','88','87','86','85','84','83','82','71','70','79','78','77','76','75','74','73','72','61','60','69','68','67','66','65','64','63','62','51','50','59','58','57','56','55','54','53','52','41','40','49','48','47','46','45','44','43','42','31','30','39','38','37','36','35','34','33','32','21'];
const PRT=[3,9,1,7,10,8,4,6,2,5,17,13,12,18,19,0,11,14,15,22,25,20,24,23,21,28,29,26,27,38,35,34,36,32,31,33,39,30,37,41,40,48,46,47,49,43,44,42,45,52,56,50,59,58,57,51,55,54,53,63,62,61,60,69,68,67,66,65,64,78,75,77,74,73,71,79,72,70,76,89,85,88,90,0,81,87,86,82,80,83];
const EQV=[8,7,6,5,4,3,2,1,90,89,88,87,86,85,84,83,82,81,80,79,78,77,76,75,74,73,72,71,70,69,68,67,66,65,64,63,62,61,60,59,58,57,56,55,54,53,52,51,50,49,48,47,46,45,44,43,42,41,40,39,38,37,36,35,34,33,32,31,30,29,28,27,26,25,24,23,22,21,20,19,18,17,16,15,14,13,12,11,10,9];
const TRN=[10,20,30,40,50,60,70,80,90,1,11,21,31,41,51,61,71,81,19,2,12,22,32,42,52,62,72,82,29,3,13,23,33,43,53,63,73,83,39,4,14,24,34,44,54,64,74,84,49,5,15,25,35,45,55,65,75,85,59,6,16,26,36,46,56,66,76,86,69,7,17,27,37,47,57,67,77,87,79,8,18,28,38,48,58,68,78,88,89,9];

// Couleurs fixes par classification
const CL_DEF=[
  {key:'counter', label:'Counter',  bg:'#1565C0', fg:'#fff'},
  {key:'bonanza', label:'Bonanza',  bg:'#E65100', fg:'#fff'},
  {key:'malta',   label:'Malta',    bg:'#6A1B9A', fg:'#fff'},
  {key:'key',     label:'Key',      bg:'#00695C', fg:'#fff'},
  {key:'turning', label:'Turning',  bg:'#F57F17', fg:'#000'},
  {key:'partner', label:'Partner',  bg:'#C62828', fg:'#fff'},
  {key:'shadow',  label:'Shadow',   bg:'#37474F', fg:'#fff'},
  {key:'equiv',   label:'Equiv',    bg:'#558B2F', fg:'#fff'},
  {key:'miroir',  label:'Miroir',   bg:'#AB47BC', fg:'#fff'},
];

const MIR={};
for(let n=10;n<=90;n++){const r=parseInt(String(n).split('').reverse().join(''));if(r!==n&&r>=1&&r<=90)MIR[n]=r;}
for(let n=1;n<=9;n++)MIR[n]=n*10; // miroir des chiffres simples : 7↔70, 9↔90...

function getCL(n){
  if(!n||n<1||n>90)return{};const i=n-1;
  return{counter:CNT[i],bonanza:BON[i],malta:MLT[i],key:KEY[i],turning:TRN[i],partner:PRT[i],shadow:SHD[i],equiv:EQV[i],code:CODE[i]};
}

// Retourne les dérivés d'un numéro par type de classification
function getDerivsByType(n){
  const c=getCL(n); const res={};
  CL_DEF.forEach(cl=>{
    if(cl.key==='miroir'){if(MIR[n])res['miroir']=MIR[n];}
    else if(c[cl.key]&&c[cl.key]>=1&&c[cl.key]<=90)res[cl.key]=c[cl.key];
  });
  return res;
}

// Ordre choisi pour que 2-3 couleurs PRISES À LA SUITE (ex: colorier les 3 derniers tirages) soient
// toujours bien distinctes à l'oeil — on alterne teintes chaudes/froides au lieu de les regrouper.
const CC=[['#EF4444','#fff'],['#3B82F6','#fff'],['#EAB308','#000'],['#8B5CF6','#fff'],['#22C55E','#fff'],['#EC4899','#fff'],['#14B8A6','#fff'],['#F97316','#fff'],['#6366F1','#fff'],['#F59E0B','#000']];
const PC=[['#0D47A1','#1565C0','#E3F2FD'],['#1B5E20','#2E7D32','#E8F5E9'],['#B71C1C','#C62828','#FFEBEE'],['#4A148C','#6A1B9A','#F3E5F5']];

function tC(s){if(s<150)return['#C8E6C9','#1B5E20'];if(s<250)return['#FFF9C4','#7B5E00'];if(s<300)return['#FFCCBC','#BF360C'];return['#EF9A9A','#B71C1C'];}

// STATE
