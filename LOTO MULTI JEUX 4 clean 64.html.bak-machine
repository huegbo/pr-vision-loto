<div id="sb-sync-badge" onclick="sbManualSync()" title="Cliquer pour forcer une synchronisation" style="position:fixed;bottom:4px;right:6px;z-index:99998;font-size:9px;font-family:-apple-system,sans-serif;background:rgba(0,0,0,.55);color:#999;padding:2px 6px;border-radius:8px;cursor:pointer;user-select:none">☁️ 🔄 Sync</div>
<div id="app">
  <div style="text-align:center;padding:60px 20px;font-family:-apple-system,sans-serif;color:#1F2D3D">
