    </div>
  </div>
  <div style="text-align:center;font-size:9px;font-weight:700;color:#999;letter-spacing:.5px;margin-bottom:8px">APERÇU POSTER</div>
  <canvas id="pronoPreviewCanvas" style="width:100%;max-width:340px;display:block;margin:0 auto 16px;border-radius:14px;box-shadow:0 6px 20px rgba(0,0,0,.25)"></canvas>`;
}
function pronosticProgrammeTabHTML(){
  if(state.pronosticGroupe==='togo'){
    const grid={};
    TOGO_GAMES.forEach(g=>{grid[g.jour]=grid[g.jour]||{};grid[g.jour][g.heure]=g;});
    const heures=[...new Set(TOGO_GAMES.map(g=>g.heure))].sort();
    return `
    <div class="card" style="margin-bottom:8px;overflow-x:auto">
      <div style="font-size:12px;font-weight:700;margin-bottom:8px">📅 Programme des tirages LONATO (Togo)</div>
      <table style="width:100%;border-collapse:collapse;font-size:10.5px">
        <thead><tr style="background:#4A2E1A;color:#fff">
          <th style="padding:6px 8px;text-align:left">JOUR</th>
          ${heures.map(h=>`<th style="padding:6px 8px">${h}</th>`).join('')}
        </tr></thead>
        <tbody>
        ${TOGO_JOUR_ORDER.map((j,ri)=>{
          const bg=ri%2===0?'#fff':'#F5F7FB';
          return `<tr>
            <td style="padding:6px 8px;font-weight:700;background:#EEF1F6">${j.toUpperCase()}</td>
            ${heures.map(h=>{
              const gm=grid[j]&&grid[j][h];
              if(!gm)return `<td style="padding:6px 8px;background:${bg};text-align:center;color:#ccc">—</td>`;
              return `<td onclick="setPronosticJeu('${gm.key}');setPronosticSubTab('pronostic')" style="padding:6px 8px;background:${bg};text-align:center;font-weight:600;cursor:pointer;color:#${gm.color}">${gm.name}</td>`;
            }).join('')}
          </tr>`;
        }).join('')}
        </tbody>
      </table>
      <div style="font-size:9px;color:#888;margin-top:8px">Touche un tirage pour le charger en Pronostic.</div>
    </div>`;
  }
  return `
  <div class="card" style="margin-bottom:8px">
    <div style="font-size:12px;font-weight:700;margin-bottom:8px">📅 Programme des tirages Bénin</div>
    <div style="display:flex;flex-direction:column;gap:6px">
      ${BENIN_JEU_ORDER.map(code=>{const c=BENIN_JEU_COLORS[code];const light=parseInt(c,16)>0x888888;return `<div onclick="setPronosticJeu('${code}');setPronosticSubTab('pronostic')" style="display:flex;align-items:center;justify-content:space-between;padding:9px 12px;border-radius:10px;cursor:pointer;background:#${c};color:${light?'#000':'#fff'};font-weight:700;font-size:12px"><span>${BENIN_JEU_LABELS[code]}</span><span>Tous les jours</span></div>`;}).join('')}
    </div>
    <div style="font-size:9px;color:#888;margin-top:8px">Touche un tirage pour le charger en Pronostic.</div>
  </div>`;
}
function pronosticHTML(){
  let html=`<div id="app-content">
  <div class="header" style="background:#16436B;color:#fff;padding:10px 14px;margin-top:calc(66px + env(safe-area-inset-top))">
    <div style="display:flex;align-items:center;gap:8px">
      <div style="font-size:14px;font-weight:600">🍀 PRONOSTIC — choisis et partage tes numéros</div>
      <button onclick="state.pronosticOpen=false;render()" style="margin-left:auto;padding:4px 10px;background:rgba(255,255,255,.15);color:#fff;border:none;border-radius:6px;cursor:pointer;font-size:11px">✕ Fermer</button>
    </div>
  </div>
  <div style="padding:10px 12px calc(70px + env(safe-area-inset-bottom))">
    ${pronosticSubTabHTML()}
    ${state.pronosticSubTab==='pronostic'?pronosticPronosticTabHTML():''}
    ${state.pronosticSubTab==='perso'?pronosticPersoTabHTML():''}
    ${state.pronosticSubTab==='programme'?pronosticProgrammeTabHTML():''}
  </div>
  </div>`;
  return html;
}
// ── Accès localStorage centralisé et sécurisé (évite de dupliquer try/catch partout) ──
function lsGetOr(key,fallback){try{return localStorage.getItem(key)||fallback;}catch(_){return fallback;}}
function applyTheme(){
  document.body.style.filter='';
  const appContent=document.getElementById('app-content');
  if(appContent){
    appContent.style.filter=state.darkMode?'invert(1) hue-rotate(180deg)':'';
    appContent.style.zoom=state.zoom;
  }
}
function toggleDarkMode(){state.darkMode=!state.darkMode;lsSet('lmj_dark',state.darkMode?'1':'0');applyTheme();render();}
function setZoom(z){state.zoom=z;lsSet('lmj_zoom',String(z));applyTheme();render();}
const ZOOM_LEVELS=[0.5,0.85,1,1.15,1.3,1.5];
function zoomStep(dir){
  let idx=ZOOM_LEVELS.indexOf(state.zoom);
  if(idx<0)idx=1; // valeur inconnue -> repli sur 100%
  idx=Math.max(0,Math.min(ZOOM_LEVELS.length-1,idx+dir));
  setZoom(ZOOM_LEVELS[idx]);
}
// ── Synchronisation Supabase (multi-appareils) ──────────────────────────
// Toute clé lue/écrite via lsGetOr/lsSet/lsRemove est aussi poussée vers/tirée
// depuis la table app_kv (key text, value json, updated_at timestamptz).
// Fonctionne en mode "best effort" : si Supabase est indisponible (hors-ligne,
// erreur réseau...), l'app continue de fonctionner normalement en local.
const SB_URL='https://hrhascbnnsjgnpinpbdx.supabase.co';
const SB_KEY='sb_publishable_nwAL0OUhV72O6sihiIC5lA_P1JQ14g1';
let SB=null;
try{ if(window.supabase&&window.supabase.createClient) SB=window.supabase.createClient(SB_URL,SB_KEY); }catch(_){SB=null;}
let sbSyncPending=0;
function sbSetStatus(txt,color){
  try{
    let el=document.getElementById('sb-sync-badge');
    if(!el)return;
    el.textContent=txt;
    el.style.color=color||'#999';
  }catch(_){}
}
function sbPush(key,rawVal){
  if(!SB)return;
  let value;
  try{ value=JSON.parse(rawVal); }catch(_){ value=rawVal; }
  sbSyncPending++;
  sbSetStatus('☁️ Synchro…','#F59E0B');
  SB.from('app_kv').upsert({key:key,value:value,updated_at:new Date().toISOString()}).then(({error})=>{
    sbSyncPending=Math.max(0,sbSyncPending-1);
    if(sbSyncPending===0)sbSetStatus(error?'⚠️ Synchro échouée':'☁️ Synchro OK',error?'#DC2626':'#16A34A');
  }).catch(()=>{
    sbSyncPending=Math.max(0,sbSyncPending-1);
    if(sbSyncPending===0)sbSetStatus('⚠️ Synchro échouée','#DC2626');
  });
}
function sbDelete(key){
  if(!SB)return;
  SB.from('app_kv').delete().eq('key',key).then(()=>{}).catch(()=>{});
}
async function sbPullAll(){
  if(!SB)return false;
  try{
    sbSetStatus('☁️ Récupération…','#F59E0B');
    const {data,error}=await SB.from('app_kv').select('key,value');
    if(error||!data){sbSetStatus('⚠️ Synchro indisponible','#DC2626');return false;}
    data.forEach(row=>{
      try{
        const str=(typeof row.value==='string')?row.value:JSON.stringify(row.value);
        localStorage.setItem(row.key,str);
      }catch(_){}
    });
    sbSetStatus(data.length?'☁️ Synchronisé':'☁️ Prêt (rien à synchro)','#16A34A');
    return true;
  }catch(_){
    sbSetStatus('⚠️ Synchro indisponible','#DC2626');
    return false;
  }
}
function lsSet(key,val){try{localStorage.setItem(key,val);sbPush(key,val);return true;}catch(_){return false;}}
function lsRemove(key){try{localStorage.removeItem(key);sbDelete(key);return true;}catch(_){return false;}}
// Synchro manuelle : bouton "🔄 Sync" (récupère les dernières données Supabase sans recharger la page)
async function sbManualSync(){
  if(!SB){sbSetStatus('⚠️ Hors-ligne (pas de connexion Supabase)','#DC2626');return;}
  const ok=await sbPullAll();
  if(ok){
    try{
      delete GAMES[GAME.key]._d; // force la relecture des extras fusionnés
      loadGame(GAME.key);
      loadColorState(GAME.key);
      loadPlansState(GAME.key);
      render();
    }catch(_){}
  }
}
function getExtras(key){
  return lsGetOr('loto_extra_'+key,'').split('\n').filter(l=>l.trim());
}
function saveExtras(key,lines){
  if(!lsSet('loto_extra_'+key,lines.join('\n')))alert('Impossible d\'enregistrer (stockage indisponible)');
}
function parseLines(lines){
  return lines.map(line=>{
    const p=line.split('|');
    const r={t:+p[0],d:p[1],y:p[2],n:[+p[3],+p[4],+p[5],+p[6],+p[7]],s:+p[8]};
    if(p.length>=14)r.m=[+p[9],+p[10],+p[11],+p[12],+p[13]];
    else if(p.length>=13&&p[9]!==undefined&&p[9]!==''&&p[10]!==''&&p[11]!==''&&p[12]!=='')r.m=[+p[9],+p[10],+p[11],+p[12],NaN]; // bonus à 4 numéros (Cameroun : BONUS 1, BONUS 2, N6, N7)
    else if(p.length>=12&&p[9]!==undefined&&p[9]!==''&&p[10]!==undefined&&p[10]!==''&&p[11]!==undefined&&p[11]!=='')r.m=[+p[9],+p[10],+p[11],NaN,NaN]; // bonus à 3 numéros
    else if(p.length>=11&&p[9]!==undefined&&p[9]!==''&&p[10]!==undefined&&p[10]!=='')r.m=[+p[9],+p[10],NaN,NaN,NaN]; // bonus à 2 numéros (ex: KADOO)
    return r;
  });
}
function loadGame(key){
  GAME=GAMES[key];GAME.key=key;
  const base=parseLines(GAME.raw.trim().split('\n'));
  const extras=parseLines(getExtras(key));
  const byT={};base.forEach(r=>byT[r.t]=r);extras.forEach(r=>byT[r.t]=r); // la saisie manuelle a priorité
  T=Object.values(byT).sort((a,b)=>b.t-a.t);
  IDX={};T.forEach((r,i)=>{IDX[r.t]=i;});
  MAX_T=T[0].t;MIN_T=T[T.length-1].t;
  YEARS=[...new Set(T.map(r=>r.y))].sort((a,b)=>parseInt(b)-parseInt(a));
  BY_YEAR={};T.forEach(r=>{if(!BY_YEAR[r.y])BY_YEAR[r.y]=[];BY_YEAR[r.y].push(r);});
  // Inverser chaque année : janvier en haut, plus récent en bas
  Object.keys(BY_YEAR).forEach(y=>{BY_YEAR[y].reverse();});
}
// Choisit automatiquement le jeu du calendrier officiel LONATO correspondant au jour (et à l'heure) actuels
function defaultGameForToday(){
  const jours=['Dimanche','Lundi','Mardi','Mercredi','Jeudi','Vendredi','Samedi'];
  const now=new Date();
  const jour=jours[now.getDay()];
  const heure=now.getHours();
  const duJour=Object.entries(GAMES).filter(([k,g])=>g.day&&g.day.startsWith(jour));
  if(!duJour.length)return 'benz'; // repli si jamais aucun jeu officiel ce jour-là
  const creneau=heure<15?'13h':'18h';
  const match=duJour.find(([k,g])=>g.day.endsWith(creneau));
  return match?match[0]:duJour[0][0];
}
loadGame(defaultGameForToday());

// Calcule les tirages restants de l'année en cours (dates + N° attendus, sans les numéros)
// pour un jeu qui suit le calendrier hebdomadaire officiel (propriété "day", ex: "Mardi 13h")
function remainingWeeklyDraws(yr){
  if(!GAME.day)return [];
  const nowY=new Date().getFullYear();
  if(parseInt(yr)!==nowY)return [];
  const joursIdx={'Dimanche':0,'Lundi':1,'Mardi':2,'Mercredi':3,'Jeudi':4,'Vendredi':5,'Samedi':6};
  const jourNom=GAME.day.split(' ')[0];
  const targetDow=joursIdx[jourNom];
  if(targetDow==null)return [];
  const rows=BY_YEAR[yr]||[];
  if(!rows.length)return [];
  const last=rows[rows.length-1]; // dernier tirage réel de l'année (le plus récent dans ce bloc)
  const [ld,lm]=last.d.split('/').map(Number);
  let cur=new Date(parseInt(yr),lm-1,ld);
  cur.setDate(cur.getDate()+1);
  while(cur.getDay()!==targetDow)cur.setDate(cur.getDate()+1);
  const out=[];
  let t=last.t+1;
  const endOfYear=new Date(parseInt(yr),11,31);
  while(cur<=endOfYear){
    out.push({t,d:String(cur.getDate()).padStart(2,'0')+'/'+String(cur.getMonth()+1).padStart(2,'0')});
    t++;
    cur.setDate(cur.getDate()+7);
  }
  return out;
}
// Lignes vides du 1er janvier jusqu'au premier tirage réel de l'année
// (pour un jeu qui a débuté en cours d'année, ex: CASH dont l'historique commence en juillet 2023)
function precedingWeeklyPlaceholders(yr){
  if(!GAME.day)return [];
  const joursIdx={'Dimanche':0,'Lundi':1,'Mardi':2,'Mercredi':3,'Jeudi':4,'Vendredi':5,'Samedi':6};
  const jourNom=GAME.day.split(' ')[0];
  const targetDow=joursIdx[jourNom];
  if(targetDow==null)return [];
  const rows=BY_YEAR[yr]||[];
  if(!rows.length)return [];
  const first=rows[0]; // premier tirage réel de l'année (le plus ancien dans ce bloc, tri croissant)
  const [fd,fm]=first.d.split('/').map(Number);
  const firstDate=new Date(parseInt(yr),fm-1,fd);
  let cur=new Date(parseInt(yr),0,1);
  while(cur.getDay()!==targetDow)cur.setDate(cur.getDate()+1);
  const out=[];
  while(cur<firstDate){
    out.push({d:String(cur.getDate()).padStart(2,'0')+'/'+String(cur.getMonth()+1).padStart(2,'0')});
    cur.setDate(cur.getDate()+7);
  }
  return out;
}
// ══════ Numéros prédits — saisis directement dans les cases vides à venir ══════
// Stockés à part (loto_predictions_<jeu>) pour ne jamais influencer statistiques/recherches.
function loadPredictions(key){
  try{return JSON.parse(lsGetOr('loto_predictions_'+key,'{}'))||{};}catch(_){return {};}
}
function savePredictionCell(key,t,ni,val){
  const preds=loadPredictions(key);
  const num=parseInt(val);
  if(val===''||isNaN(num)){
    if(preds[t]){delete preds[t][ni];if(!Object.keys(preds[t]).length)delete preds[t];}
  }else{
    if(!preds[t])preds[t]={};
    preds[t][ni]=Math.min(90,Math.max(1,num));
  }
  lsSet('loto_predictions_'+key,JSON.stringify(preds));
}
function prefillAddDraw(t,d,y){
  state.prefillT=t;state.prefillD=d;state.prefillY=String(y);
  state.prefillN=null;state.prefillM=null;
  state.showAdd=true;
  render();
  setTimeout(()=>{const el=document.getElementById('ad-n1');if(el)el.scrollIntoView({behavior:'smooth',block:'center'});},50);
}
// Modifier un tirage déjà saisi : ouvre le formulaire pré-rempli avec ses valeurs actuelles.
// Ré-enregistrer (addDraw) avec le MÊME N° de tirage remplace la ligne existante (voir addDraw()).
function editDraw(t){
  const row=T[IDX[t]];
  if(!row){alert('Tirage introuvable');return;}
  state.prefillT=row.t;state.prefillD=row.d;state.prefillY=String(row.y);
  state.prefillN=[...row.n];
  state.prefillM=row.m?[...row.m].map(v=>isNaN(v)?'':v):null;
  state.showAdd=true;
  render();
  setTimeout(()=>{const el=document.getElementById('ad-n1');if(el)el.scrollIntoView({behavior:'smooth',block:'center'});},50);
}
// Insérer un tirage manquant à côté d'une ligne existante : ouvre le formulaire vierge, en suggérant
// le N° suivant celui de la ligne cliquée (utile quand un tirage entier manque dans la séquence).
function insertDraw(nearT){
  const row=T[IDX[nearT]];
  state.prefillT=nearT+1;
  state.prefillD='';
  state.prefillY=row?String(row.y):YEARS[0];
  state.prefillN=null;state.prefillM=null;
  state.showAdd=true;
  render();
  setTimeout(()=>{const el=document.getElementById('ad-t');if(el)el.scrollIntoView({behavior:'smooth',block:'center'});},50);
}

