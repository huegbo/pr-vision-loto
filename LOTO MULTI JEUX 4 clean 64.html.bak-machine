  const tog=(on)=>`<span style="display:inline-block;width:40px;height:22px;border-radius:11px;background:${on?'#22C55E':'#ccc'};position:relative;transition:.2s"><span style="position:absolute;top:2px;left:${on?'20px':'2px'};width:18px;height:18px;border-radius:50%;background:#fff;transition:.2s"></span></span>`;
  return`<div onclick="closeSettings()" style="position:fixed;inset:0;background:rgba(0,0,0,.4);z-index:998"></div>
  <div style="position:fixed;left:50%;top:50%;transform:translate(-50%,-50%);z-index:999;background:#fff;border-radius:16px;padding:16px;width:320px;max-width:88vw;max-height:80vh;overflow-y:auto;box-shadow:0 12px 40px rgba(0,0,0,.5)">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:12px">
