  pronosticTitleSize:'normal', pronosticAlign:'center',        // taille et alignement du titre
  searchPosMode:'any', searchPosIdx:null,
  showSearchHub:false, searchHist:[], totalSearch:'', totalMatches:[], comboRes:null, totalK:5, cqInput:'', cqRes:null, showFab:false, showSettings:false, showBonusDefault:true, longPressTransform:true, multiGameSearch:false, multiGames:[], multiCqRes:null, formInput:"2*n+1", formTerms:6, formRes:null,
