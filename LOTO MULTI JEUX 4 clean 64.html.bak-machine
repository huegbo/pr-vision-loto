let T,IDX,MAX_T,MIN_T,YEARS,BY_YEAR,GAME;

// ══════ BENIN — filtre Jour / Jeu (vue dédiée, indépendante de GAMES) ══════
let BENIN_ALL_ROWS=null;
const BENIN_JOUR_LABELS={L:'Lundi',MA:'Mardi',ME:'Mercredi',J:'Jeudi',V:'Vendredi',S:'Samedi',D:'Dimanche'};
const BENIN_JOUR_ORDER=['L','MA','ME','J','V','S','D'];
const BENIN_JEU_LABELS={F11:'Fortune 11H',F14:'Fortune 14H',F18:'Fortune 18H',S11:'Star 11H',S14:'Star 14H',S18:'Star 18H',D00:'Digital 00H',D20:'Digital 20H'};
const BENIN_JEU_ORDER=['D00','D20','F11','F14','F18','S11','S14','S18'];
const BENIN_JEU_COLORS={D00:'0E7C7B',D20:'17A398',F11:'1D4E89',F14:'2C6FB0',F18:'4A90D9',S11:'6D28D9',S14:'8B5CF6',S18:'A78BFA'};
function parseBeninAll(){
  if(BENIN_ALL_ROWS) return BENIN_ALL_ROWS;
  BENIN_ALL_ROWS=RAW_BENIN_ALL.trim().split('\n').map(line=>{
    const p=line.split('|');
    const n=[+p[4],+p[5],+p[6],+p[7],+p[8]];
    const s=p[9]===''?null:+p[9];
    const mRaw=[p[10],p[11],p[12],p[13],p[14]];
    const hasM=mRaw.some(v=>v!=='');
    const m=hasM?mRaw.map(v=>v===''?null:+v):null;
    return {jour:p[0],jeu:p[1],d:p[2],y:p[3],n,s,m};
  });
  return BENIN_ALL_ROWS;
}
function toggleBeninJour(code){
  const i=state.beninJours.indexOf(code);
  if(i>=0)state.beninJours.splice(i,1);else state.beninJours.push(code);
  render();
}
function toggleBeninJeu(code){
  const i=state.beninJeux.indexOf(code);
  if(i>=0)state.beninJeux.splice(i,1);else state.beninJeux.push(code);
  render();
}
// Heure et famille : déduites du code du jeu (D00 -> 00H / Digital, F14 -> 14H / Fortune ...)
const BENIN_HEURE={D00:'00H',D20:'20H',F11:'11H',S11:'11H',F14:'14H',S14:'14H',F18:'18H',S18:'18H'};
const BENIN_HEURE_ORDER=['00H','11H','14H','18H','20H'];
const BENIN_FAMILLE={D:'Digital',F:'Fortune',S:'Star'};
const BENIN_FAMILLE_ORDER=['Fortune','Star','Digital'];
const BENIN_FAMILLE_COLORS={Fortune:'1D4E89',Star:'6D28D9',Digital:'0E7C7B'};
// Le tirage du soir s'appelait "Digital 21H" jusqu'au 14/06/2026, puis "Digital 20H".
const BENIN_BASCULE_D20=new Date(2026,5,15);
function beninNomOrigine(r){
  if(r.jeu!=='D20')return BENIN_JEU_LABELS[r.jeu];
  const[dd,mm]=r.d.split('/');
  return (new Date(+r.y,+mm-1,+dd)<BENIN_BASCULE_D20)?'Digital 21H':'Digital 20H';
}
function toggleBeninHeure(h){
  const i=state.beninHeures.indexOf(h);
  if(i>=0)state.beninHeures.splice(i,1);else state.beninHeures.push(h);
  render();
}
function toggleBeninFamille(f){
  const i=state.beninFamilles.indexOf(f);
  if(i>=0)state.beninFamilles.splice(i,1);else state.beninFamilles.push(f);
  render();
}
function beninResetFiltres(){
  state.beninJours=[...BENIN_JOUR_ORDER];state.beninJeux=[...BENIN_JEU_ORDER];
  state.beninHeures=[...BENIN_HEURE_ORDER];state.beninFamilles=[...BENIN_FAMILLE_ORDER];render();
}
function beninFiltreHTML(){
  if(!state.beninHeures)state.beninHeures=[...BENIN_HEURE_ORDER];
  if(!state.beninFamilles)state.beninFamilles=[...BENIN_FAMILLE_ORDER];
  const rows=parseBeninAll().filter(r=>state.beninJours.includes(r.jour)&&state.beninJeux.includes(r.jeu)
    &&state.beninHeures.includes(BENIN_HEURE[r.jeu])&&state.beninFamilles.includes(BENIN_FAMILLE[r.jeu[0]]));
  let html=`<div id="app-content">
  <div class="header" style="background:#111F33;color:#fff;padding:10px 14px;margin-top:calc(66px + env(safe-area-inset-top))">
    <div style="display:flex;align-items:center;gap:8px">
      <div style="font-size:14px;font-weight:600">🇧🇯 BENIN — Filtre Jour / Jeu</div>
      <button onclick="state.beninFiltreOpen=false;render()" style="margin-left:auto;padding:4px 10px;background:rgba(255,255,255,.15);color:#fff;border:none;border-radius:6px;cursor:pointer;font-size:11px">✕ Fermer</button>
    </div>
  </div>
  <div style="padding:10px 12px calc(70px + env(safe-area-inset-bottom))">
    <div class="card" style="margin-bottom:8px">
      <div style="font-size:10px;font-weight:600;margin-bottom:4px">Jour</div>
      <div style="display:flex;flex-wrap:wrap;gap:4px;margin-bottom:6px">
        ${BENIN_JOUR_ORDER.map(code=>{const sel=state.beninJours.includes(code);return `<button onclick="toggleBeninJour('${code}')" style="padding:3px 9px;font-size:10px;border-radius:14px;cursor:pointer;font-weight:500;border:${sel?'2px solid #1F2D3D':'1px solid #ddd'};background:${sel?'#1F2D3D':'#f5f5f5'};color:${sel?'#fff':'#777'}">${BENIN_JOUR_LABELS[code]}</button>`;}).join('')}
        <button onclick="state.beninJours=[...BENIN_JOUR_ORDER];render()" style="padding:3px 9px;font-size:10px;border-radius:14px;border:1px solid #2E7D32;background:#E8F5E9;color:#2E7D32;cursor:pointer;font-weight:500">Tous</button>
        <button onclick="state.beninJours=[];render()" style="padding:3px 9px;font-size:10px;border-radius:14px;border:1px solid #C62828;background:#FFEBEE;color:#C62828;cursor:pointer;font-weight:500">Aucun</button>
      </div>
      <div style="font-size:10px;font-weight:600;margin-bottom:4px">Jeu</div>
      <div style="display:flex;flex-wrap:wrap;gap:4px">
        ${BENIN_JEU_ORDER.map(code=>{const sel=state.beninJeux.includes(code);const c=BENIN_JEU_COLORS[code];const light=parseInt(c,16)>0x888888;return `<button onclick="toggleBeninJeu('${code}')" style="padding:3px 9px;font-size:10px;border-radius:14px;cursor:pointer;font-weight:500;border:${sel?'2px solid #'+c:'1px solid #ddd'};background:${sel?'#'+c:'#f5f5f5'};color:${sel?(light?'#000':'#fff'):'#777'}">${BENIN_JEU_LABELS[code]}</button>`;}).join('')}
        <button onclick="state.beninJeux=[...BENIN_JEU_ORDER];render()" style="padding:3px 9px;font-size:10px;border-radius:14px;border:1px solid #2E7D32;background:#E8F5E9;color:#2E7D32;cursor:pointer;font-weight:500">Tous</button>
        <button onclick="state.beninJeux=[];render()" style="padding:3px 9px;font-size:10px;border-radius:14px;border:1px solid #C62828;background:#FFEBEE;color:#C62828;cursor:pointer;font-weight:500">Aucun</button>
      </div>
      <div style="font-size:10px;font-weight:600;margin:6px 0 4px">Heure</div>
      <div style="display:flex;flex-wrap:wrap;gap:4px">
        ${BENIN_HEURE_ORDER.map(h=>{const sel=state.beninHeures.includes(h);return `<button onclick="toggleBeninHeure('${h}')" style="padding:3px 11px;font-size:10px;border-radius:14px;cursor:pointer;font-weight:600;border:${sel?'2px solid #B45309':'1px solid #ddd'};background:${sel?'#B45309':'#f5f5f5'};color:${sel?'#fff':'#777'}">${h}</button>`;}).join('')}
        <button onclick="state.beninHeures=[...BENIN_HEURE_ORDER];render()" style="padding:3px 9px;font-size:10px;border-radius:14px;border:1px solid #2E7D32;background:#E8F5E9;color:#2E7D32;cursor:pointer;font-weight:500">Toutes</button>
      </div>
      <div style="font-size:10px;font-weight:600;margin:6px 0 4px">Famille</div>
      <div style="display:flex;flex-wrap:wrap;gap:4px">
        ${BENIN_FAMILLE_ORDER.map(f=>{const sel=state.beninFamilles.includes(f);const c=BENIN_FAMILLE_COLORS[f];return `<button onclick="toggleBeninFamille('${f}')" style="padding:3px 11px;font-size:10px;border-radius:14px;cursor:pointer;font-weight:600;border:${sel?'2px solid #'+c:'1px solid #ddd'};background:${sel?'#'+c:'#f5f5f5'};color:${sel?'#fff':'#777'}">${f}</button>`;}).join('')}
        <button onclick="beninResetFiltres()" style="padding:3px 9px;font-size:10px;border-radius:14px;border:1px solid #374151;background:#F3F4F6;color:#374151;cursor:pointer;font-weight:500">↺ Tout réinitialiser</button>
      </div>
      <div style="font-size:9px;color:#888;margin-top:5px">Astuce : pour voir les tirages du lundi à 18H, garde <b>Lundi</b> en jour et <b>18H</b> en heure.</div>
    </div>
    <div style="font-size:10px;color:#777;margin-bottom:6px">${rows.length} tirage${rows.length>1?'s':''} correspondant${rows.length>1?'s':''}</div>
    <div style="max-height:65vh;overflow:auto;border:1px solid var(--line);border-radius:10px">
      <table class="excel-tbl"><thead><tr>
        ${['Jour','Jeu',"Nom d'origine",'Heure','Date','N1','N2','N3','N4','N5','TOT','M1','M2','M3','M4','M5','TOT.M'].map(h=>`<th style="position:sticky;top:0;background:#111F33;color:#fff;font-size:9px;padding:5px 4px">${h}</th>`).join('')}
      </tr></thead><tbody>
      ${rows.map((r,ri)=>{
        const bg=ri%2===0?'#fff':'#F5F7FB';
        const jc=BENIN_JEU_COLORS[r.jeu];const light=parseInt(jc,16)>0x888888;
        const ms=r.m?r.m.reduce((a,b)=>a+(b||0),0):null;
        const mCells=r.m?r.m.map(v=>`<td style="background:${bg};color:#6D28D9;font-weight:600;font-size:9.5px;padding:4px">${v!=null?v:'·'}</td>`).join(''):Array(5).fill(`<td style="background:${bg};font-size:9.5px;padding:4px;color:#ccc">·</td>`).join('');
        return `<tr>
          <td style="background:#E8EAF6;font-weight:600;font-size:9.5px;padding:4px">${BENIN_JOUR_LABELS[r.jour]}</td>
          <td style="background:#${jc};color:${light?'#000':'#fff'};font-weight:600;font-size:9px;padding:4px">${BENIN_JEU_LABELS[r.jeu]}</td>
          <td style="background:#F3F4F6;color:#374151;font-weight:500;font-size:9px;padding:4px">${beninNomOrigine(r)}</td>
          <td style="background:#FDF3E3;color:#B45309;font-weight:700;font-size:9px;padding:4px">${BENIN_HEURE[r.jeu]}</td>
          <td style="background:${bg};font-size:9.5px;padding:4px">${r.d}/${r.y}</td>
          ${r.n.map(n=>`<td style="background:${bg};font-size:9.5px;padding:4px">${n}</td>`).join('')}
          <td style="background:#FFF3CD;font-weight:700;font-size:9.5px;padding:4px">${r.s!=null?r.s:'·'}</td>
          ${mCells}
          <td style="background:${ms!=null?'#EDE7FF':bg};font-weight:700;font-size:9.5px;padding:4px">${ms!=null?ms:'·'}</td>
        </tr>`;
      }).join('')}
      </tbody></table>
    </div>
  </div>
  </div>`;
  return html;
}
const GHANA_JOUR_LABELS={MO:'Lundi',TU:'Mardi',WE:'Mercredi',TH:'Jeudi',FR:'Vendredi',SA:'Samedi',SU:'Dimanche'};
const GHANA_JOUR_ORDER=['MO','TU','WE','TH','FR','SA','SU'];
const GHANA_JEU_LABELS={G1:'5-39 Direct Friday',G2:'5-39 Direct Monday',G3:'5-39 Direct Saturday',G4:'5-39 Direct Thursday',G5:'5-39 Direct Tuesday',G6:'5-39 Direct Wednesday',G7:'DAYWA',G8:'FORTUNE THURSDAY',G9:'FRIDAY BONANZA',G10:'Friday Noon Rush',G11:'Golden Souvenir',G12:'LUCKY TUESDAY',G13:'MID WEEK',G14:'MONDAY SPECIAL',G15:'Monday Noon Rush',G16:'Obiri',G17:'Old Soldier',G18:'Pioneer',G19:'SUNDAY ASEDA',G20:'Saturday Noon Rush',G21:'Sports',G22:'Sunday Special',G23:'Super 6',G24:'Thursday Noon Rush',G25:'Tuesday Noon Rush',G26:'VAG',G27:'VAG Friday',G28:'VAG Monday',G29:'VAG Saturday',G30:'VAG Thursday',G31:'VAG Tuesday',G32:'VAG Wednesday',G33:'Vag East',G34:'Vag West',G35:'Wednesday Noon Rush'};
const GHANA_JEU_ORDER=['G1','G2','G3','G4','G5','G6','G7','G8','G9','G10','G11','G12','G13','G14','G15','G16','G17','G18','G19','G20','G21','G22','G23','G24','G25','G26','G27','G28','G29','G30','G31','G32','G33','G34','G35'];
const GHANA_JEU_COLORS={G1:'0E7C7B',G2:'17A398',G3:'2DC6B0',G4:'1D4E89',G5:'2C6FB0',G6:'4A90D9',G7:'6D28D9',G8:'8B5CF6',G9:'A78BFA',G10:'B45309',G11:'D97706',G12:'F59E0B',G13:'BE123C',G14:'E11D48',G15:'FB7185',G16:'15803D',G17:'16A34A',G18:'4ADE80',G19:'5B21B6',G20:'7C3AED',G21:'9333EA',G22:'0369A1',G23:'0284C7',G24:'38BDF8',G25:'9D174D',G26:'DB2777',G27:'F472B6',G28:'334155',G29:'475569',G30:'64748B',G31:'78350F',G32:'92400E',G33:'B45309',G34:'1E293B',G35:'44403C'};

let GHANA_ALL_ROWS=null;
function parseGhanaAll(){
  if(GHANA_ALL_ROWS) return GHANA_ALL_ROWS;
  GHANA_ALL_ROWS=RAW_GHANA_ALL.trim().split('\n').map(line=>{
    const p=line.split('|');
    const n=[+p[4],+p[5],+p[6],+p[7],+p[8]];
    const mRaw=[p[9],p[10],p[11],p[12],p[13]];
    const hasM=mRaw.some(v=>v!=='');
    const m=hasM?mRaw.map(v=>v===''?null:+v):null;
    return {jour:p[0],jeu:p[1],d:p[2],y:p[3],n,m};
  });
  return GHANA_ALL_ROWS;
}
function toggleGhanaJour(code){
  const i=state.ghanaJours.indexOf(code);
  if(i>=0)state.ghanaJours.splice(i,1);else state.ghanaJours.push(code);
  render();
}
function toggleGhanaJeu(code){
  const i=state.ghanaJeux.indexOf(code);
  if(i>=0)state.ghanaJeux.splice(i,1);else state.ghanaJeux.push(code);
  render();
}
function ghanaFiltreHTML(){
  const rows=parseGhanaAll().filter(r=>state.ghanaJours.includes(r.jour)&&state.ghanaJeux.includes(r.jeu));
  let html=`<div id="app-content">
  <div class="header" style="background:#0B2A1E;color:#fff;padding:10px 14px;margin-top:calc(66px + env(safe-area-inset-top))">
    <div style="display:flex;align-items:center;gap:8px">
      <div style="font-size:14px;font-weight:600">🇬🇭 GHANA — Filtre Jour / Jeu</div>
      <button onclick="state.ghanaFiltreOpen=false;render()" style="margin-left:auto;padding:4px 10px;background:rgba(255,255,255,.15);color:#fff;border:none;border-radius:6px;cursor:pointer;font-size:11px">✕ Fermer</button>
    </div>
  </div>
  <div style="padding:10px 12px calc(70px + env(safe-area-inset-bottom))">
    <div class="card" style="margin-bottom:8px">
      <div style="font-size:10px;font-weight:600;margin-bottom:4px">Jour</div>
      <div style="display:flex;flex-wrap:wrap;gap:4px;margin-bottom:6px">
        ${GHANA_JOUR_ORDER.map(code=>{const sel=state.ghanaJours.includes(code);return `<button onclick="toggleGhanaJour('${code}')" style="padding:3px 9px;font-size:10px;border-radius:14px;cursor:pointer;font-weight:500;border:${sel?'2px solid #0B2A1E':'1px solid #ddd'};background:${sel?'#0B2A1E':'#f5f5f5'};color:${sel?'#fff':'#777'}">${GHANA_JOUR_LABELS[code]}</button>`;}).join('')}
        <button onclick="state.ghanaJours=[...GHANA_JOUR_ORDER];render()" style="padding:3px 9px;font-size:10px;border-radius:14px;border:1px solid #2E7D32;background:#E8F5E9;color:#2E7D32;cursor:pointer;font-weight:500">Tous</button>
        <button onclick="state.ghanaJours=[];render()" style="padding:3px 9px;font-size:10px;border-radius:14px;border:1px solid #C62828;background:#FFEBEE;color:#C62828;cursor:pointer;font-weight:500">Aucun</button>
      </div>
      <div style="font-size:10px;font-weight:600;margin-bottom:4px">Jeu (${state.ghanaJeux.length}/${GHANA_JEU_ORDER.length})</div>
      <div style="display:flex;flex-wrap:wrap;gap:4px;max-height:130px;overflow-y:auto">
        ${GHANA_JEU_ORDER.map(code=>{const sel=state.ghanaJeux.includes(code);const c=GHANA_JEU_COLORS[code];const light=parseInt(c,16)>0x888888;return `<button onclick="toggleGhanaJeu('${code}')" style="padding:3px 8px;font-size:9.5px;border-radius:14px;cursor:pointer;font-weight:500;border:${sel?'2px solid #'+c:'1px solid #ddd'};background:${sel?'#'+c:'#f5f5f5'};color:${sel?(light?'#000':'#fff'):'#777'}">${GHANA_JEU_LABELS[code]}</button>`;}).join('')}
      </div>
      <div style="display:flex;gap:4px;margin-top:6px">
        <button onclick="state.ghanaJeux=[...GHANA_JEU_ORDER];render()" style="padding:3px 9px;font-size:10px;border-radius:14px;border:1px solid #2E7D32;background:#E8F5E9;color:#2E7D32;cursor:pointer;font-weight:500">Tous</button>
        <button onclick="state.ghanaJeux=[];render()" style="padding:3px 9px;font-size:10px;border-radius:14px;border:1px solid #C62828;background:#FFEBEE;color:#C62828;cursor:pointer;font-weight:500">Aucun</button>
      </div>
    </div>
    <div style="font-size:10px;color:#777;margin-bottom:6px">${rows.length} tirage${rows.length>1?'s':''} correspondant${rows.length>1?'s':''}</div>
    <div style="max-height:65vh;overflow:auto;border:1px solid var(--line);border-radius:10px">
      <table class="excel-tbl"><thead><tr>
        ${['Jour','Jeu','Date','N1','N2','N3','N4','N5','TOT','M1','M2','M3','M4','M5','TOT.M'].map(h=>`<th style="position:sticky;top:0;background:#0B2A1E;color:#fff;font-size:9px;padding:5px 4px">${h}</th>`).join('')}
      </tr></thead><tbody>
      ${rows.map((r,ri)=>{
        const bg=ri%2===0?'#fff':'#F5F7FB';
        const jc=GHANA_JEU_COLORS[r.jeu];const light=parseInt(jc,16)>0x888888;
        const tot=r.n.reduce((a,b)=>a+b,0);
        const ms=r.m?r.m.reduce((a,b)=>a+(b||0),0):null;
        const mCells=r.m?r.m.map(v=>`<td style="background:${bg};color:#6D28D9;font-weight:600;font-size:9.5px;padding:4px">${v!=null?v:'·'}</td>`).join(''):Array(5).fill(`<td style="background:${bg};font-size:9.5px;padding:4px;color:#ccc">·</td>`).join('');
        return `<tr>
          <td style="background:#E4F0E9;font-weight:600;font-size:9.5px;padding:4px">${GHANA_JOUR_LABELS[r.jour]}</td>
          <td style="background:#${jc};color:${light?'#000':'#fff'};font-weight:600;font-size:8.5px;padding:4px">${GHANA_JEU_LABELS[r.jeu]}</td>
          <td style="background:${bg};font-size:9.5px;padding:4px">${r.d}/${r.y}</td>
          ${r.n.map(n=>`<td style="background:${bg};font-size:9.5px;padding:4px">${n}</td>`).join('')}
          <td style="background:#FFF3CD;font-weight:700;font-size:9.5px;padding:4px">${tot}</td>
          ${mCells}
          <td style="background:${ms!=null?'#EDE7FF':bg};font-weight:700;font-size:9.5px;padding:4px">${ms!=null?ms:'·'}</td>
        </tr>`;
      }).join('')}
      </tbody></table>
    </div>
  </div>
  </div>`;
  return html;
}
// ══════ TOGO (LONATO) — filtre Jour / Jeu (vue dédiée, unifie les 12 jeux hebdo) ══════
const TOGO_GAMES=[
  {key:'diamant',name:'DIAMANT',jour:'Lundi',heure:'13h',raw:RAW_DIAMANT,color:'1D4E89'},
  {key:'gold',name:'GOLD',jour:'Lundi',heure:'18h',raw:RAW_GOLD,color:'2C6FB0'},
  {key:'cash',name:'CASH',jour:'Mardi',heure:'13h',raw:RAW_CASH,color:'6D28D9'},
  {key:'boom',name:'BOOM',jour:'Mardi',heure:'18h',raw:RAW_BOOM,color:'8B5CF6'},
  {key:'benz',name:'BENZ',jour:'Mercredi',heure:'13h',raw:RAW_STR,color:'0E7C7B'},
  {key:'prestige',name:'PRESTIGE',jour:'Mercredi',heure:'18h',raw:RAW_PRESTIGE,color:'17A398'},
  {key:'million',name:'MILLION',jour:'Jeudi',heure:'13h',raw:RAW_MILLION,color:'B45309'},
  {key:'super',name:'SUPER',jour:'Jeudi',heure:'18h',raw:RAW_SUPER,color:'D97706'},
  {key:'kadoo',name:'KADOO',jour:'Vendredi',heure:'13h',raw:RAW_KADOO,color:'BE123C'},
  {key:'king',name:'KING',jour:'Vendredi',heure:'18h',raw:RAW_KING,color:'E11D48'},
  {key:'sam',name:'SAM',jour:'Samedi',heure:'13h',raw:RAW_SAM,color:'15803D'},
  {key:'bingo',name:'BINGO',jour:'Samedi',heure:'18h',raw:RAW_BINGO,color:'16A34A'},
];
const TOGO_JOUR_ORDER=['Lundi','Mardi','Mercredi','Jeudi','Vendredi','Samedi'];
const TOGO_JEU_ORDER=TOGO_GAMES.map(g=>g.key);
const TOGO_JEU_LABELS=Object.fromEntries(TOGO_GAMES.map(g=>[g.key,`${g.name} (${g.heure})`]));
const TOGO_JEU_COLORS=Object.fromEntries(TOGO_GAMES.map(g=>[g.key,g.color]));
let TOGO_ALL_ROWS=null;
function parseTogoAll(){
  if(TOGO_ALL_ROWS) return TOGO_ALL_ROWS;
  TOGO_ALL_ROWS=[];
  TOGO_GAMES.forEach(g=>{
    g.raw.trim().split('\n').forEach(line=>{
      if(!line.trim())return;
      const p=line.split('|');
      const t=+p[0],d=p[1],y=p[2];
      const n=[+p[3],+p[4],+p[5],+p[6],+p[7]];
      const s=p[8]!==undefined&&p[8]!==''?+p[8]:n.reduce((a,b)=>a+b,0);
      const bonusRaw=p.slice(9).filter(v=>v!==undefined&&v!=='');
      const bonus=bonusRaw.length?bonusRaw.map(v=>+v):null;
      TOGO_ALL_ROWS.push({jour:g.jour,jeu:g.key,t,d,y,n,s,bonus});
    });
  });
  TOGO_ALL_ROWS.sort((a,b)=>(b.y+b.d.split('/').reverse().join('')).localeCompare(a.y+a.d.split('/').reverse().join(''))||b.t-a.t);
  return TOGO_ALL_ROWS;
}
function toggleTogoJour(code){
  const i=state.togoJours.indexOf(code);
  if(i>=0)state.togoJours.splice(i,1);else state.togoJours.push(code);
  render();
}
function toggleTogoJeu(code){
  const i=state.togoJeux.indexOf(code);
  if(i>=0)state.togoJeux.splice(i,1);else state.togoJeux.push(code);
  render();
}
function togoFiltreHTML(){
  const rows=parseTogoAll().filter(r=>state.togoJours.includes(r.jour)&&state.togoJeux.includes(r.jeu));
  let html=`<div id="app-content">
  <div class="header" style="background:#4A2E1A;color:#fff;padding:10px 14px;margin-top:calc(66px + env(safe-area-inset-top))">
    <div style="display:flex;align-items:center;gap:8px">
      <div style="font-size:14px;font-weight:600">🇹🇬 TOGO (LONATO) — Filtre Jour / Jeu</div>
      <button onclick="state.togoFiltreOpen=false;render()" style="margin-left:auto;padding:4px 10px;background:rgba(255,255,255,.15);color:#fff;border:none;border-radius:6px;cursor:pointer;font-size:11px">✕ Fermer</button>
    </div>
  </div>
  <div style="padding:10px 12px calc(70px + env(safe-area-inset-bottom))">
    <div class="card" style="margin-bottom:8px">
      <div style="font-size:10px;font-weight:600;margin-bottom:4px">Jour</div>
      <div style="display:flex;flex-wrap:wrap;gap:4px;margin-bottom:6px">
        ${TOGO_JOUR_ORDER.map(code=>{const sel=state.togoJours.includes(code);return `<button onclick="toggleTogoJour('${code}')" style="padding:3px 9px;font-size:10px;border-radius:14px;cursor:pointer;font-weight:500;border:${sel?'2px solid #4A2E1A':'1px solid #ddd'};background:${sel?'#4A2E1A':'#f5f5f5'};color:${sel?'#fff':'#777'}">${code}</button>`;}).join('')}
        <button onclick="state.togoJours=[...TOGO_JOUR_ORDER];render()" style="padding:3px 9px;font-size:10px;border-radius:14px;border:1px solid #2E7D32;background:#E8F5E9;color:#2E7D32;cursor:pointer;font-weight:500">Tous</button>
        <button onclick="state.togoJours=[];render()" style="padding:3px 9px;font-size:10px;border-radius:14px;border:1px solid #C62828;background:#FFEBEE;color:#C62828;cursor:pointer;font-weight:500">Aucun</button>
      </div>
      <div style="font-size:10px;font-weight:600;margin-bottom:4px">Jeu (${state.togoJeux.length}/${TOGO_JEU_ORDER.length})</div>
      <div style="display:flex;flex-wrap:wrap;gap:4px;max-height:130px;overflow-y:auto">
        ${TOGO_JEU_ORDER.map(code=>{const sel=state.togoJeux.includes(code);const c=TOGO_JEU_COLORS[code];const light=parseInt(c,16)>0x888888;return `<button onclick="toggleTogoJeu('${code}')" style="padding:3px 8px;font-size:9.5px;border-radius:14px;cursor:pointer;font-weight:500;border:${sel?'2px solid #'+c:'1px solid #ddd'};background:${sel?'#'+c:'#f5f5f5'};color:${sel?(light?'#000':'#fff'):'#777'}">${TOGO_JEU_LABELS[code]}</button>`;}).join('')}
      </div>
      <div style="display:flex;gap:4px;margin-top:6px">
        <button onclick="state.togoJeux=[...TOGO_JEU_ORDER];render()" style="padding:3px 9px;font-size:10px;border-radius:14px;border:1px solid #2E7D32;background:#E8F5E9;color:#2E7D32;cursor:pointer;font-weight:500">Tous</button>
        <button onclick="state.togoJeux=[];render()" style="padding:3px 9px;font-size:10px;border-radius:14px;border:1px solid #C62828;background:#FFEBEE;color:#C62828;cursor:pointer;font-weight:500">Aucun</button>
      </div>
    </div>
    <div style="font-size:10px;color:#777;margin-bottom:6px">${rows.length} tirage${rows.length>1?'s':''} correspondant${rows.length>1?'s':''}</div>
    <div style="max-height:65vh;overflow:auto;border:1px solid var(--line);border-radius:10px">
      <table class="excel-tbl"><thead><tr>
        ${['Jour','Jeu','Date','Event','N1','N2','N3','N4','N5','TOT','Bonus'].map(h=>`<th style="position:sticky;top:0;background:#4A2E1A;color:#fff;font-size:9px;padding:5px 4px">${h}</th>`).join('')}
      </tr></thead><tbody>
      ${rows.map((r,ri)=>{
        const bg=ri%2===0?'#fff':'#F5F7FB';
        const jc=TOGO_JEU_COLORS[r.jeu];const light=parseInt(jc,16)>0x888888;
        return `<tr>
          <td style="background:#F0E6DA;font-weight:600;font-size:9.5px;padding:4px">${r.jour}</td>
          <td style="background:#${jc};color:${light?'#000':'#fff'};font-weight:600;font-size:8.5px;padding:4px">${TOGO_JEU_LABELS[r.jeu]}</td>
          <td style="background:${bg};font-size:9.5px;padding:4px">${r.d}/${r.y}</td>
          <td style="background:${bg};font-size:9px;padding:4px;color:#888">${r.t}</td>
          ${r.n.map(n=>`<td style="background:${bg};font-size:9.5px;padding:4px">${n}</td>`).join('')}
          <td style="background:#FFF3CD;font-weight:700;font-size:9.5px;padding:4px">${r.s}</td>
          <td style="background:${r.bonus?'#EDE7FF':bg};color:#6D28D9;font-weight:600;font-size:9.5px;padding:4px">${r.bonus?r.bonus.join(' - '):'·'}</td>
        </tr>`;
      }).join('')}
      </tbody></table>
    </div>
  </div>
  </div>`;
  return html;
}
// ══════ PRONOSTIC — choisis tes numéros et partage-les (Togo + Bénin) ══════
const PRONO_FORMATS=[
  {key:'numeros',label:'Numéros'},
  {key:'nap',label:'NAP'},
  {key:'perm',label:'Perm'},
  {key:'surs',label:'Sûrs'},
  {key:'sursperm',label:'2 Sûrs+Perm'},
];
const PRONO_COUNT_PRESETS=[2,3,4,5,10,15,20,23,30,40];
const PRONO_BALL_COLORS=[
  {key:'def',label:'Déf',css:null},
  {key:'multi',label:'🌈',css:'conic-gradient(from 0deg,#f00,#ff0,#0f0,#0ff,#00f,#f0f,#f00)'},
  {key:'blue',css:'#2C6FB0'},
  {key:'orange',css:'#D97706'},
  {key:'red',css:'#DC2626'},
  {key:'green',css:'#16A34A'},
  {key:'purple',css:'#7C3AED'},
  {key:'yellow',css:'#CA8A04'},
  {key:'pink',css:'#DB2777'},
  {key:'cyan',css:'#0891B2'},
  {key:'black',css:'#111827'},
];
const PRONO_FONTS=[
  {key:'def',label:'Aa',name:'Poppins',family:'Poppins, Arial, sans-serif',weight:700},
  {key:'serif',label:'Aa',name:'Georgia',family:'Georgia, serif',weight:700},
  {key:'mono',label:'Aa',name:'Courier',family:'"Courier New", monospace',weight:700},
  {key:'round',label:'Aa',name:'Verdana',family:'Verdana, sans-serif',weight:900},
  {key:'script',label:'Aa',name:'Script',family:'"Brush Script MT", cursive',weight:400},
  // polices ajoutées
  {key:'bear',label:'Aa',name:'Bear',family:'"Baloo 2","Comic Sans MS",Verdana,sans-serif',weight:900},
  {key:'impact',label:'Aa',name:'Impact',family:'Impact,"Arial Black",sans-serif',weight:900},
  {key:'black',label:'Aa',name:'Arial Black',family:'"Arial Black",Arial,sans-serif',weight:900},
  {key:'times',label:'Aa',name:'Times',family:'"Times New Roman",serif',weight:700},
  {key:'palatino',label:'Aa',name:'Palatino',family:'"Palatino Linotype",Palatino,serif',weight:700},
  {key:'trebuchet',label:'Aa',name:'Trebuchet',family:'"Trebuchet MS",sans-serif',weight:700},
  {key:'tahoma',label:'Aa',name:'Tahoma',family:'Tahoma,Geneva,sans-serif',weight:700},
  {key:'garamond',label:'Aa',name:'Garamond',family:'Garamond,"Times New Roman",serif',weight:700},
  {key:'copper',label:'Aa',name:'Copperplate',family:'Copperplate,"Copperplate Gothic Light",fantasy',weight:700},
  {key:'chalk',label:'Aa',name:'Chalk',family:'"Chalkboard SE","Comic Sans MS",cursive',weight:700},
];
const PRONO_TITLE_SIZES=[['petit','Petit',0.72],['normal','Normal',1],['grand','Grand',1.24],['xl','Très grand',1.48]];
const PRONO_ALIGNS=[['left','⬅︎','left'],['center','⬛︎','center'],['right','➡︎','right']];
function pronosticGames(){
  if(state.pronosticGroupe==='togo'){
    return TOGO_GAMES.map(g=>({key:g.key,label:g.name,sub:`${g.jour} ${g.heure}`,color:g.color,icon:(GAMES[g.key]&&GAMES[g.key].icon)||'💎'}));
  }
  return BENIN_JEU_ORDER.map(code=>({key:code,label:BENIN_JEU_LABELS[code],sub:'',color:BENIN_JEU_COLORS[code],icon:code[0]==='D'?'🔢':(code[0]==='F'?'💰':'⭐')}));
}
function currentPronosticGame(){
  const list=pronosticGames();
  return list.find(g=>g.key===state.pronosticJeu)||list[0];
}
function setPronosticGroupe(g){
  state.pronosticGroupe=g;
  state.pronosticJeu=(g==='togo'?TOGO_GAMES[0].key:BENIN_JEU_ORDER[0]);
  render();
}
function setPronosticJeu(k){state.pronosticJeu=k;render();}
function setPronosticFormat(f){state.pronosticFormat=f;render();}
function setPronosticCount(c){
  c=Math.max(1,Math.min(90,+c||1));
  state.pronosticCount=c;
  if(state.pronosticNums.length>c)state.pronosticNums=state.pronosticNums.slice(-c);
  render();
}
function stepPronosticCount(d){setPronosticCount(state.pronosticCount+d);}
function setPronosticBoulesFilter(f){state.pronosticBoulesFilter=f;render();}
function pronosticNumEnabled(n){
  const f=state.pronosticBoulesFilter;
  if(f==='pairs')return n%2===0;
  if(f==='impairs')return n%2===1;
  if(f==='1-45')return n<=45;
  if(f==='46-90')return n>=46;
  return true;
}
function togglePronosticNum(n){
  const i=state.pronosticNums.indexOf(n);
  if(i>=0){state.pronosticNums.splice(i,1);state.pronosticAuto=0;}
  else{
    state.pronosticNums.push(n);
    // AVANT : si on dépassait le format, le plus ancien était SUPPRIMÉ EN SILENCE.
    // On voyait donc ses numéros à l'écran mais l'affiche en sortait d'autres.
    // Maintenant on garde tout et on augmente le format automatiquement, en le signalant.
    if(state.pronosticNums.length>state.pronosticCount){
      state.pronosticCount=Math.min(90,state.pronosticNums.length);
      state.pronosticAuto=(state.pronosticAuto||0)+1;
    }else state.pronosticAuto=0;
  }
  render();
}
function setPronosticBallSize(s){state.pronosticBallSize=s;render();}
function setPronosticTextSize(s){state.pronosticTextSize=s;render();}
function setPronosticBallColor(c){state.pronosticBallColor=c;render();}
// Contour des boules : absent par défaut ; si activé, sa couleur est réglable
// ('auto' = la couleur de l'affiche, sinon une couleur choisie dans la palette).
function setPronosticOutline(v){state.pronosticOutline=!!v;render();}
function setPronosticOutlineColor(c){state.pronosticOutlineColor=c;render();}
// Ordre des numéros à l'export : celui de la SAISIE (par défaut) ou croissant.
// Avant, tout était trié de force : l'affiche ne correspondait pas à ce qui avait été tapé.
function pronosticNumsOrdered(){
  const n=state.pronosticNums.slice();
  return state.pronosticOrdre==='croissant'?n.sort((a,b)=>a-b):n;
}
function setPronosticOrdre(o){state.pronosticOrdre=o;render();}
function setPronosticTitleSize(s){state.pronosticTitleSize=s;render();}
function setPronosticAlign(a){state.pronosticAlign=a;render();}
function setPronosticTitleFont(f){state.pronosticTitleFont=f;render();}
function setPronosticSubTab(t){state.pronosticSubTab=t;render();}
function pronosticBallCss(gameColor){
  const c=PRONO_BALL_COLORS.find(x=>x.key===state.pronosticBallColor);
  if(!c||!c.css)return '#'+gameColor;
  return c.css;
}
function buildPronosticTitre(){
  if(state.pronosticTitre&&state.pronosticTitre.trim())return state.pronosticTitre.trim();
  const g=currentPronosticGame();
  const fmt=PRONO_FORMATS.find(f=>f.key===state.pronosticFormat);
  return `Mes ${state.pronosticNums.length} ${fmt.label} ${g.label}`;
}
function buildPronosticText(){
  const g=currentPronosticGame();
  const fmt=PRONO_FORMATS.find(f=>f.key===state.pronosticFormat);
  const nums=pronosticNumsOrdered();
  const groupeLabel=state.pronosticGroupe==='togo'?'LONATO (Togo)':'BÉNIN';
  return `🍀 ${buildPronosticTitre()}\n${g.icon} ${g.label}${g.sub?' • '+g.sub:''} (${groupeLabel})\nFormat : ${fmt.label} • ${nums.length} numéro${nums.length>1?'s':''}\nNuméros : ${nums.join(' - ')||'—'}\nBonne chance !`;
}
function copyPronosticText(){
  const txt=buildPronosticText();
  const done=()=>alert('Pronostic copié ! Tu peux le coller dans WhatsApp, Facebook, etc.');
  if(navigator.clipboard&&navigator.clipboard.writeText){
    navigator.clipboard.writeText(txt).then(done).catch(()=>fallbackCopy(txt,done));
  }else fallbackCopy(txt,done);
}
function fallbackCopy(txt,done){
  try{
    const ta=document.createElement('textarea');
    ta.value=txt;ta.style.position='fixed';ta.style.opacity='0';
    document.body.appendChild(ta);ta.select();document.execCommand('copy');ta.remove();
    done();
  }catch(_){alert('Impossible de copier automatiquement. Sélectionne et copie le texte manuellement.');}
}
function sharePronosticText(){
  const txt=buildPronosticText();
  if(navigator.share){
    navigator.share({text:txt,title:buildPronosticTitre()}).catch(()=>{});
  }else{
    copyPronosticText();
  }
}
// ── Affiche « Combinaison chance » (carte claire, badge LONATO / LNB) ──────
// Helpers canvas : coins arrondis et texte espacé (letterSpacing n'existe pas partout).
function _rr(ctx,x,y,w,h,r){
  ctx.beginPath();
  if(ctx.roundRect){ctx.roundRect(x,y,w,h,r);return;}
  ctx.moveTo(x+r,y);ctx.lineTo(x+w-r,y);ctx.quadraticCurveTo(x+w,y,x+w,y+r);
  ctx.lineTo(x+w,y+h-r);ctx.quadraticCurveTo(x+w,y+h,x+w-r,y+h);
  ctx.lineTo(x+r,y+h);ctx.quadraticCurveTo(x,y+h,x,y+h-r);
  ctx.lineTo(x,y+r);ctx.quadraticCurveTo(x,y,x+r,y);ctx.closePath();
}
function _spaced(ctx,txt,cx,y,sp){
  const chars=[...txt];
  let total=0;chars.forEach(c=>{total+=ctx.measureText(c).width+sp;});
  total-=sp;
  let x=cx-total/2;const prev=ctx.textAlign;ctx.textAlign='left';
  chars.forEach(c=>{ctx.fillText(c,x,y);x+=ctx.measureText(c).width+sp;});
  ctx.textAlign=prev;
  return total;
}
// Losange évidé avec la petite croix au centre (le logo des modèles)
function _diamond(ctx,cx,cy,size,color){
  ctx.save();ctx.translate(cx,cy);ctx.rotate(Math.PI/4);
  ctx.strokeStyle=color;ctx.lineWidth=size*0.17;ctx.lineJoin='miter';
  ctx.strokeRect(-size/2,-size/2,size,size);
  ctx.restore();
  ctx.save();ctx.strokeStyle=color;ctx.globalAlpha=.30;ctx.lineWidth=size*0.055;
  const d=size*0.30;
  ctx.beginPath();ctx.moveTo(cx-d,cy-d);ctx.lineTo(cx+d,cy+d);
  ctx.moveTo(cx+d,cy-d);ctx.lineTo(cx-d,cy+d);ctx.stroke();
  ctx.restore();
}
// Valeurs partagées par l'aperçu à l'écran ET l'image exportée : une seule source
// de vérité, pour que ce que tu vois soit exactement ce que tu télécharges.
// Éclaircit une couleur #rrggbb vers le blanc (k=0 → couleur, k=1 → blanc)
function _lighten(hex,k){
  const h=hex.replace('#','');
  const n=parseInt(h.length===3?h.split('').map(c=>c+c).join(''):h,16);
  const r=(n>>16)&255,g=(n>>8)&255,b=n&255;
  const m=v=>Math.round(v+(255-v)*k);
  return '#'+[m(r),m(g),m(b)].map(v=>v.toString(16).padStart(2,'0')).join('');
}
function pronosticVisual(){
  const g=currentPronosticGame();
  const togo=state.pronosticGroupe==='togo';
  const src=(g.sub||'')+' '+(g.label||'');
  const mh=src.match(/(\d{1,2})\s*[hH:]\s*(\d{2})?/);
  const jeu=(g.label||'').replace(/\s*\d{1,2}\s*[hH:]\s*\d{0,2}\s*/,' ').replace(/\s+/g,' ').trim();
  // La couleur choisie dans « Couleur des boules » pilote TOUTE l'affiche
  // (losange, badge, titre, heure, anneau des boules) pour éviter tout mélange.
  const custom=PRONO_BALL_COLORS.find(x=>x.key===state.pronosticBallColor);
  const conic=!!(custom&&custom.css&&custom.css.startsWith('conic'));
  const chosen=(custom&&custom.css&&!conic)?custom.css:null;
  const ACC=chosen||(togo?'#1B3A8C':'#3E8E4F');   // défaut : bleu LONATO / vert LNB
  // Contour : rien par défaut. Si activé : 'auto' suit l'affiche, sinon la couleur choisie.
  const oc=PRONO_BALL_COLORS.find(x=>x.key===state.pronosticOutlineColor);
  const outline=!state.pronosticOutline?null
               :(state.pronosticOutlineColor==='auto'||!oc||!oc.css||oc.css.startsWith('conic')?ACC:oc.css);
  return {
    g, togo, conic, outline,
    ACC,
    LIGHT: _lighten(ACC,0.84),                    // remplissage clair des boules
    BADGE: togo?'LONATO':'LNB',
    heure: mh?`${mh[1].padStart(2,'0')}:${mh[2]||'00'}`:'',
    titre: (state.pronosticTitre&&state.pronosticTitre.trim())
           ? state.pronosticTitre.trim().toUpperCase() : ('LOTO '+jeu).toUpperCase(),
    nums:  pronosticNumsOrdered()
  };
}
// Aperçu de l'affiche : on réutilise LE MÊME canvas et LA MÊME fonction de dessin
// que l'export, donc l'aperçu ne peut pas différer de l'image téléchargée.
function pronosticPreviewHTML(){
  return `<div class="card" style="margin-bottom:8px;background:#131C2E;padding:10px">
    <div style="text-align:center;font-size:9px;font-weight:700;color:rgba(255,255,255,.6);letter-spacing:1px;margin-bottom:8px">APERÇU DE L'AFFICHE</div>
    <canvas id="pronoPreviewCanvas" style="width:100%;max-width:330px;display:block;margin:0 auto;border-radius:14px"></canvas>
    ${state.pronosticNums.length?'':'<div style="text-align:center;font-size:10px;color:rgba(255,255,255,.55);margin-top:8px">Choisis tes numéros ci-dessous</div>'}
  </div>`;
}
function drawPronosticPoster(canvas){
  const v=pronosticVisual();
  const {ACC,LIGHT,BADGE,heure,titre,nums}=v;
  // Mise en page : 5 boules par rangée, hauteur adaptée au nombre de numéros.
  // Le rayon est calculé pour qu'une rangée complète TIENNE dans la carte
  // (sinon les boules débordaient : 5×116 + 4×26 = 684 px pour 608 px utiles).
  const perRow=5, GAP=18;
  const M=26, PAD=34;                       // marge extérieure, padding de la carte
  const W=660;
  const avail=W-2*(M+PAD);
  const R=Math.min(58,Math.floor((avail-(perRow-1)*GAP)/(2*perRow)));
  const rows=Math.max(1,Math.ceil(nums.length/perRow));
  const ballsTop=470;
  const H=ballsTop+rows*(R*2+GAP)-GAP+150;
  canvas.width=W;canvas.height=H;
  const ctx=canvas.getContext('2d');
  ctx.textAlign='center';
  // Alignement du paragraphe (logo, badge, textes) : gauche / centré / droite
  const al=state.pronosticAlign||'center';
  const AX = al==='left' ? M+PAD+120 : al==='right' ? W-M-PAD-120 : W/2;
  // fond sombre + carte blanche arrondie
  ctx.fillStyle='#131C2E';ctx.fillRect(0,0,W,H);
  ctx.fillStyle='#FFFFFF';_rr(ctx,M,M,W-M*2,H-M*2,42);ctx.fill();
  // logo losange
  _diamond(ctx,AX,M+94,74,ACC);
  // badge LONATO / LNB
  ctx.font='800 26px Poppins, Arial, sans-serif';
  const bw=ctx.measureText(BADGE).width+8*BADGE.length+70;
  ctx.fillStyle=ACC;_rr(ctx,AX-bw/2,M+150,bw,64,32);ctx.fill();
  ctx.fillStyle='#FFFFFF';_spaced(ctx,BADGE,AX,M+192,8);
  // COMBINAISON CHANCE
  ctx.fillStyle='#8A93A6';ctx.font='700 22px Poppins, Arial, sans-serif';
  _spaced(ctx,'COMBINAISON CHANCE',AX,M+266,7);
  // titre du jeu (police, taille et alignement réglables)
  const fontDef=PRONO_FONTS.find(f=>f.key===state.pronosticTitleFont)||PRONO_FONTS[0];
  const kSize=(PRONO_TITLE_SIZES.find(s=>s[0]===state.pronosticTitleSize)||PRONO_TITLE_SIZES[1])[2];
  ctx.fillStyle=ACC;
  let ts=Math.round(54*kSize);ctx.font=`900 ${ts}px ${fontDef.family}`;
  while(ctx.measureText(titre).width>W-2*(M+PAD)&&ts>20){ts-=2;ctx.font=`900 ${ts}px ${fontDef.family}`;}
  ctx.fillText(titre,AX,M+336);
  // heure
  if(heure){ctx.fillStyle=ACC;ctx.font=`800 ${Math.round(42*kSize)}px Poppins, Arial, sans-serif`;ctx.fillText(heure,AX,M+396);}
  // boules : 5 par rangée — fond clair de la couleur choisie, contour seulement si demandé
  for(let i=0;i<nums.length;i++){
    const row=Math.floor(i/perRow);
    const inRow=Math.min(perRow,nums.length-row*perRow);
    const totalW=inRow*(R*2)+(inRow-1)*GAP;
    const x0=(al==='left'?M+PAD:al==='right'?W-M-PAD-totalW:W/2-totalW/2)+R;
    const cx=x0+(i%perRow)*(R*2+GAP);
    const cy=ballsTop+row*(R*2+GAP)+R;
    ctx.beginPath();ctx.arc(cx,cy,R,0,Math.PI*2);
    if(v.conic){
      const cg=ctx.createConicGradient?ctx.createConicGradient(0,cx,cy):null;
      if(cg){['#f00','#ff0','#0f0','#0ff','#00f','#f0f','#f00'].forEach((c,ci,a)=>cg.addColorStop(ci/(a.length-1),c));ctx.fillStyle=cg;}
      else ctx.fillStyle=LIGHT;
    }else ctx.fillStyle=LIGHT;
    ctx.fill();
    if(v.outline){ctx.strokeStyle=v.outline;ctx.lineWidth=5;ctx.stroke();}
    ctx.fillStyle=v.conic?'#FFFFFF':'#131C2E';
    const tsz={petit:32,normal:40,grand:46}[state.pronosticTextSize]||40;
    ctx.font=`800 ${tsz}px Poppins, Arial, sans-serif`;
    ctx.textBaseline='middle';ctx.fillText(String(nums[i]),cx,cy+2);ctx.textBaseline='alphabetic';
  }
  // pastille GOOD LUCK
  const gy=ballsTop+rows*(R*2+GAP)-GAP+46;
  ctx.font='800 24px Poppins, Arial, sans-serif';
  const gw=ctx.measureText('GOOD LUCK').width+9*9+80;
  ctx.fillStyle='#EEF1F6';_rr(ctx,AX-gw/2,gy,gw,62,31);ctx.fill();
  ctx.fillStyle='#5A6478';_spaced(ctx,'GOOD LUCK',AX,gy+40,9);
}
function drawPronosticPosterOld(canvas){
  const g=currentPronosticGame();
  const fmt=PRONO_FORMATS.find(f=>f.key===state.pronosticFormat);
  const nums=pronosticNumsOrdered();
  const groupeLabel=state.pronosticGroupe==='togo'?'LONATO • TOGO':'LONATO • BÉNIN';
  const W=640,H=800;
  canvas.width=W;canvas.height=H;
  const ctx=canvas.getContext('2d');
  // fond
  const grad=ctx.createLinearGradient(0,0,0,H);
  grad.addColorStop(0,'#0F2E4E');grad.addColorStop(1,'#16436B');
  ctx.fillStyle=grad;ctx.fillRect(0,0,W,H);
  ctx.strokeStyle='rgba(255,255,255,.15)';ctx.lineWidth=2;
  ctx.strokeRect(20,20,W-40,H-40);
  // badge
  ctx.fillStyle='#1F2D3D';
  const badgeTxt=`${groupeLabel}`;
  ctx.font='bold 18px Arial';
  const bw=ctx.measureText(badgeTxt).width+40;
  ctx.beginPath();ctx.roundRect ? ctx.roundRect((W-bw)/2,50,bw,34,17) : ctx.rect((W-bw)/2,50,bw,34);ctx.fill();
  ctx.fillStyle='#fff';ctx.textAlign='center';ctx.fillText(badgeTxt,W/2,74);
  // icone
  ctx.font='54px Arial';ctx.fillText(g.icon,W/2,150);
  // sous-titre
  ctx.fillStyle='rgba(255,255,255,.65)';ctx.font='bold 15px Arial';
  ctx.fillText('COMBINAISON CHANCE',W/2,180);
  // titre
  const fontDef=PRONO_FONTS.find(f=>f.key===state.pronosticTitleFont)||PRONO_FONTS[0];
  ctx.fillStyle='#fff';ctx.font=`${fontDef.weight} 30px ${fontDef.family}`;
  ctx.fillText(buildPronosticTitre(),W/2,225,W-80);
  ctx.font='bold 18px Arial';ctx.fillStyle='#8FD3FF';
  ctx.fillText(`${g.label}${g.sub?' '+g.sub:''}`,W/2,255);
  // boules
  const sizeMap={petites:36,moyennes:46,grandes:58};
  const r=sizeMap[state.pronosticBallSize]||46;
  const gap=18;
  const totalW=nums.length*(r*2+gap)-gap;
  let startX=W/2-totalW/2+r;
  const cy=340;
  const ballFill=pronosticBallCss(g.color);
  nums.forEach((n,i)=>{
    const cx=startX+i*(r*2+gap);
    ctx.beginPath();ctx.arc(cx,cy,r,0,Math.PI*2);
    if(ballFill.startsWith('conic-gradient')){
      const cg=ctx.createConicGradient?ctx.createConicGradient(0,cx,cy):null;
      if(cg){['#f00','#ff0','#0f0','#0ff','#00f','#f0f','#f00'].forEach((c,ci,arr)=>cg.addColorStop(ci/(arr.length-1),c));ctx.fillStyle=cg;}
      else ctx.fillStyle='#7C3AED';
    }else ctx.fillStyle=ballFill;
    ctx.fill();
    ctx.strokeStyle='#fff';ctx.lineWidth=3;ctx.stroke();
    const txtSizeMap={petit:20,normal:24,grand:30};
    ctx.fillStyle='#fff';ctx.font=`bold ${txtSizeMap[state.pronosticTextSize]||24}px Arial`;
    ctx.textBaseline='middle';
    ctx.fillText(String(n),cx,cy+2);
    ctx.textBaseline='alphabetic';
  });
  // tagline
  ctx.fillStyle='rgba(255,255,255,.75)';ctx.font='italic 16px Arial';
  ctx.fillText('Choisis avec soin, joue avec plaisir !',W/2,cy+r+50);
  // footer
  ctx.fillStyle='rgba(255,255,255,.55)';ctx.font='14px Arial';
  ctx.fillText(`Bonne chance • ${state.pronosticGroupe==='togo'?'LONATO 🇹🇬':'BÉNIN 🇧🇯'}`,W/2,H-70);
  ctx.fillStyle='#111F33';ctx.fillRect(20,H-50,W-40,30);
  ctx.fillStyle='#fff';ctx.font='bold 13px Arial';
  ctx.fillText(`${state.pronosticGroupe==='togo'?'TOGO':'BÉNIN'} • ${nums.length} NUMÉRO${nums.length>1?'S':''} • ${fmt.label.toUpperCase()}`,W/2,H-30);
}
function downloadPronosticPoster(){
  if(!state.pronosticNums.length){alert('Choisis au moins un numéro avant de générer l\'affiche.');return;}
  const canvas=document.createElement('canvas');
  drawPronosticPoster(canvas);
  canvas.toBlob(blob=>{
    const a=document.createElement('a');
    a.href=URL.createObjectURL(blob);
    a.download='pronostic_'+currentPronosticGame().key+'_'+Date.now()+'.png';
    document.body.appendChild(a);a.click();
    setTimeout(()=>{URL.revokeObjectURL(a.href);a.remove();},500);
  },'image/png');
}
function pronosticSubTabHTML(){
  const tabs=[['pronostic','Pronostic'],['perso','Perso'],['programme','Programme']];
  return `<div style="display:flex;gap:4px;margin-bottom:10px">
    ${tabs.map(([k,l])=>`<div onclick="setPronosticSubTab('${k}')" style="flex:1;text-align:center;padding:8px 4px;border-radius:10px;cursor:pointer;font-size:11px;font-weight:700;letter-spacing:.3px;background:${state.pronosticSubTab===k?'#16436B':'#EEF1F6'};color:${state.pronosticSubTab===k?'#fff':'#555'}">${l.toUpperCase()}</div>`).join('')}
  </div>`;
}
function pronosticPronosticTabHTML(){
  const games=pronosticGames();
  const g=currentPronosticGame();
  return pronosticPreviewHTML()+`
  <div class="card" style="margin-bottom:8px">
    <div style="font-size:10px;font-weight:600;margin-bottom:6px">Groupe</div>
    <div style="display:flex;gap:6px">
      <button onclick="setPronosticGroupe('togo')" style="flex:1;padding:8px;border-radius:10px;cursor:pointer;font-weight:700;font-size:12px;border:${state.pronosticGroupe==='togo'?'2px solid #4A2E1A':'1px solid #ddd'};background:${state.pronosticGroupe==='togo'?'#4A2E1A':'#f5f5f5'};color:${state.pronosticGroupe==='togo'?'#fff':'#777'}">🇹🇬 Togo (LONATO)</button>
      <button onclick="setPronosticGroupe('benin')" style="flex:1;padding:8px;border-radius:10px;cursor:pointer;font-weight:700;font-size:12px;border:${state.pronosticGroupe==='benin'?'2px solid #111F33':'1px solid #ddd'};background:${state.pronosticGroupe==='benin'?'#111F33':'#f5f5f5'};color:${state.pronosticGroupe==='benin'?'#fff':'#777'}">🇧🇯 Bénin</button>
    </div>
  </div>
  <div class="card" style="margin-bottom:8px">
    <div style="font-size:10px;font-weight:600;margin-bottom:6px">Jeu</div>
    <div style="display:flex;flex-wrap:wrap;gap:4px;max-height:120px;overflow-y:auto">
      ${games.map(x=>{const sel=x.key===state.pronosticJeu;const light=parseInt(x.color,16)>0x888888;return `<button onclick="setPronosticJeu('${x.key}')" style="padding:5px 9px;font-size:10.5px;border-radius:14px;cursor:pointer;font-weight:600;border:${sel?'2px solid #'+x.color:'1px solid #ddd'};background:${sel?'#'+x.color:'#f5f5f5'};color:${sel?(light?'#000':'#fff'):'#777'}">${x.icon} ${x.label}${x.sub?' ('+x.sub+')':''}</button>`;}).join('')}
    </div>
  </div>
  <div class="card" style="margin-bottom:8px">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px">
      <div style="font-size:10px;font-weight:600">Format</div>
      <span style="font-size:10px;color:#888;background:#EEF1F6;padding:2px 8px;border-radius:10px">${PRONO_FORMATS.find(f=>f.key===state.pronosticFormat).label}</span>
    </div>
    <div style="display:flex;flex-wrap:wrap;gap:5px">
      ${PRONO_FORMATS.map(f=>`<button onclick="setPronosticFormat('${f.key}')" style="padding:6px 11px;font-size:11px;border-radius:14px;cursor:pointer;font-weight:600;border:${state.pronosticFormat===f.key?'2px solid #16436B':'1px solid #ddd'};background:${state.pronosticFormat===f.key?'#16436B':'#f5f5f5'};color:${state.pronosticFormat===f.key?'#fff':'#777'}">${f.label}</button>`).join('')}
    </div>
  </div>
  <div class="card" style="margin-bottom:8px">
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px">
      <div style="font-size:10px;font-weight:600">Nombre de numéros</div>
      <div style="display:flex;align-items:center;gap:8px">
        <span onclick="stepPronosticCount(-1)" style="width:26px;height:26px;border-radius:50%;background:#111F33;color:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;font-weight:700">－</span>
        <span style="font-size:15px;font-weight:700;min-width:20px;text-align:center">${state.pronosticCount}</span>
        <span onclick="stepPronosticCount(1)" style="width:26px;height:26px;border-radius:50%;background:#111F33;color:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;font-weight:700">＋</span>
      </div>
    </div>
    <div style="font-size:9.5px;color:#888;margin-bottom:6px">${state.pronosticCount} numéro${state.pronosticCount>1?'s':''} • Mode ${PRONO_FORMATS.find(f=>f.key===state.pronosticFormat).label}</div>
    <div style="display:flex;flex-wrap:wrap;gap:5px">
      ${PRONO_COUNT_PRESETS.map(c=>`<button onclick="setPronosticCount(${c})" style="padding:5px 10px;font-size:11px;border-radius:14px;cursor:pointer;font-weight:600;border:${state.pronosticCount===c?'2px solid #16436B':'1px solid #ddd'};background:${state.pronosticCount===c?'#16436B':'#f5f5f5'};color:${state.pronosticCount===c?'#fff':'#777'}">${c}</button>`).join('')}
    </div>
  </div>
  <div class="card" style="margin-bottom:8px">
    <div style="font-size:10px;font-weight:600;margin-bottom:6px">Filtre boules</div>
    <div style="display:flex;flex-wrap:wrap;gap:5px;margin-bottom:8px">
      ${[['tous','Tous'],['pairs','Pairs'],['impairs','Impairs'],['1-45','1-45'],['46-90','46-90']].map(([k,l])=>`<button onclick="setPronosticBoulesFilter('${k}')" style="padding:5px 10px;font-size:10.5px;border-radius:14px;cursor:pointer;font-weight:600;border:${state.pronosticBoulesFilter===k?'2px solid #16436B':'1px solid #ddd'};background:${state.pronosticBoulesFilter===k?'#16436B':'#f5f5f5'};color:${state.pronosticBoulesFilter===k?'#fff':'#777'}">${l}</button>`).join('')}
    </div>
    <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:6px">
      <div style="font-size:10px;font-weight:600">Numéros (1-90)</div>
      <span style="font-size:10px;background:${state.pronosticAuto?'#2E7D32':'#16436B'};color:#fff;padding:2px 8px;border-radius:10px">${state.pronosticNums.length}/${state.pronosticCount}</span>
      ${state.pronosticAuto?`<span style="font-size:9px;color:#2E7D32;font-weight:600">↑ format porté à ${state.pronosticCount} — aucun numéro perdu</span>`:''}
    </div>
    <div style="display:grid;grid-template-columns:repeat(9,1fr);gap:4px">
      ${Array.from({length:90},(_,i)=>i+1).map(n=>{
        const sel=state.pronosticNums.includes(n);
        const enabled=pronosticNumEnabled(n);
        return `<div onclick="${enabled?`togglePronosticNum(${n})`:''}" style="aspect-ratio:1;display:flex;align-items:center;justify-content:center;border-radius:8px;font-size:11px;font-weight:600;cursor:${enabled?'pointer':'default'};background:${sel?'#16436B':(enabled?'#EEF1F6':'#F8F8F8')};color:${sel?'#fff':(enabled?'#333':'#ccc')}">${n}</div>`;
      }).join('')}
    </div>
    <div style="display:flex;align-items:center;gap:6px;margin-top:8px;flex-wrap:wrap;padding:5px 7px;background:#F3F7FF;border:1px solid #BBD3F5;border-radius:8px">
      <span style="font-size:10px;font-weight:600;color:#1565C0">Ordre à l'export :</span>
      ${[['saisi','Comme saisi'],['croissant','Croissant']].map(([k,l])=>`<button onclick="setPronosticOrdre('${k}')" style="padding:4px 11px;border-radius:12px;cursor:pointer;font-weight:600;font-size:10.5px;border:1.5px solid #1565C0;background:${state.pronosticOrdre===k?'#1565C0':'#fff'};color:${state.pronosticOrdre===k?'#fff':'#1565C0'}">${l}</button>`).join('')}
      <span style="font-size:9px;color:#666">l'affiche et le texte partagé suivent ce choix</span>
    </div>
    <div style="font-size:9px;color:#999;margin-top:8px">Touche tes numéros. Le plus ancien est remplacé si tu dépasses le format.</div>
    ${state.pronosticNums.length?`<div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:8px">${state.pronosticNums.map(n=>`<span style="width:34px;height:34px;border-radius:50%;background:#16436B;color:#fff;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px">${n}</span>`).join('')}</div>`:''}
  </div>
  <div class="card" style="margin-bottom:8px">
    <div style="font-size:10px;font-weight:600;margin-bottom:6px">Titre du pronostic</div>
    <input type="text" placeholder="${buildPronosticTitre()}" value="${state.pronosticTitre}" oninput="state.pronosticTitre=this.value" style="width:100%;padding:8px 10px;border:1.5px solid #ddd;border-radius:8px;font-size:13px;box-sizing:border-box">
  </div>
  <div style="display:flex;gap:6px;padding-bottom:6px">
    <button onclick="copyPronosticText()" style="flex:1;padding:11px;border-radius:10px;border:none;background:#EEF1F6;color:#333;font-weight:700;font-size:12px;cursor:pointer">📋 Copier</button>
    <button onclick="sharePronosticText()" style="flex:1;padding:11px;border-radius:10px;border:none;background:#16436B;color:#fff;font-weight:700;font-size:12px;cursor:pointer">🔗 Partager</button>
    <button onclick="downloadPronosticPoster()" style="flex:1;padding:11px;border-radius:10px;border:none;background:#22C55E;color:#fff;font-weight:700;font-size:12px;cursor:pointer">🖼️ Affiche</button>
  </div>`;
}
