      ${PRONO_TITLE_SIZES.map(([k,l])=>`<button onclick="setPronosticTitleSize('${k}')" style="flex:1;padding:8px 4px;border-radius:10px;cursor:pointer;font-weight:600;font-size:10.5px;border:none;background:${state.pronosticTitleSize===k?'#111F33':'#EEF1F6'};color:${state.pronosticTitleSize===k?'#fff':'#555'}">${l}</button>`).join('')}
